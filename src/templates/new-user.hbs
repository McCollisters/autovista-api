<html>

  <head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <title>Welcome to the AutoVista Portal</title>
  </head>

  <body
    style="font-family: Helvetica, Arial, sans-serif; margin: 0 auto; width: 600px; padding: 0; font-size: 14px; -webkit-text-size-adjust:100%; -ms-text-size-adjust:100%;"
  >
    <table
      class="table"
      cellpadding="0"
      cellspacing="0"
      style="empty-cells: hide; margin: 0 auto; padding: 15px; width: 600px;"
    >
      <tr>
        <td valign="top" style="width: 600px;">
          <p
            style="box-sizing: border-box; font-family: Helvetica, Arial, sans-serif; letter-spacing: 0.5px; line-height: 1.4; margin-bottom: 15px;"
          >Hello
            {{firstName}},</p>
        </td>
      </tr>

      <tr>
        <td valign="top" style="width: 600px;">
          <p
            style="box-sizing: border-box; font-family: Helvetica, Arial, sans-serif; letter-spacing: 0.5px; line-height: 1.4; margin: 0; "
          >{{{emailIntro}}}</p>
        </td>
      </tr>

      <tr>
        <td valign="top" style="width: 600px;padding-bottom: 15px;">
          <p
            style="box-sizing: border-box; font-family: Helvetica, Arial, sans-serif; letter-spacing: 0.5px; line-height: 1.4; margin: 0; "
          >You can activate your account and create your password by clicking:</p>
          <p
            style="box-sizing: border-box; font-family: Helvetica, Arial, sans-serif; letter-spacing: 0.5px; line-height: 1.4; margin: 0; "
          >
            <a
              style="margin-bottom: 30px;"
              href="{{resetUrl}}"
            >this link.</a>
          </p>
        </td>
      </tr>

      <tr>
        <td valign="top" style="width: 600px;padding-bottom: 15px;">
          <p
            style="box-sizing: border-box; font-family: Helvetica, Arial, sans-serif; letter-spacing: 0.5px; line-height: 1.4; margin: 0;"
          >{{{emailBody}}}</p>
        </td>
      </tr>

      <tr>

        <td valign="top" style="width: 600px;padding-bottom: 15px;">
          <p>McCollister's Auto Transport</p>
          <img
                    src="https://autovista-assets.s3.us-west-1.amazonaws.com/MCC-Wordmark-RGB-Blue.png"
                    alt="McCollister's Auto Transport"
                    width="220"
                    style="display: block; width: 220px; max-width: 220px; height: auto; border: 0; outline: none; text-decoration: none; -ms-interpolation-mode: bicubic; margin: 0 0 12px 0;"
                />
          <p><a href="tel:8888190594" style="color: #0069ca;">(888) 819-0594</a><br
            />autotransport@mccollisters.com</p>
        </td>
      </tr>

    </table>
  </body>

</html>