<html>

  <head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <title>Order Tracking</title>
  </head>

  <body
    style="font-size: 14px; margin: 0 auto; width: 600px; padding: 0; -webkit-text-size-adjust:100%; -ms-text-size-adjust:100%;"
  >
    <table
      class="table"
      cellpadding="0"
      cellspacing="0"
      style="empty-cells: hide; margin: 0 auto; padding: 15px; width: 600px"
    >
      <tr>
        <td valign="top" style="width: 600px; margin: 0 auto;">
          <p
            style="box-sizing: border-box; font-family: Helvetica, Arial, sans-serif; letter-spacing: 0.5px; line-height: 1.4; margin-bottom: 15px; "
          >Dear
            {{recipientName}},</p>
        </td>
      </tr>

      <tr>
        <td valign="top" style="width: 600px; margin: 0 auto;">
          <p
            style="box-sizing: border-box; font-family: Helvetica, Arial, sans-serif; letter-spacing: 0.5px; line-height: 1.4; margin-bottom: 15px; "
          >Now that your vehicle(s) is/are on the way to destination, we wanted
            to provide a way for you to track progress of your vehicle during
            transport.
          </p>
        </td>
      </tr>

      {{{tracking}}}

      <tr>
        <td valign="top" style="width: 600px; margin: 0 auto;">
          <p
            style="box-sizing: border-box; font-family: Helvetica, Arial, sans-serif; letter-spacing: 0.5px; line-height: 1.4; margin-bottom: 15px; "
          >Please see the link below that will bring you to our Tracking Page
            where you can send a location request to your driver.
          </p>
          <p
            style="box-sizing: border-box; font-family: Helvetica, Arial, sans-serif; letter-spacing: 0.5px; line-height: 1.4; margin-bottom: 15px; "
          >Your Order ID# is:
            {{refId}}.
          </p>
          <p><a
              href="https://autovista.mccollisters.com/track-order"
            >https://autovista.mccollisters.com/track-order</a></p>
        </td>
      </tr>

      <tr>
        <td
          valign="top"
          style="width: 600px;padding-bottom: 15px;margin: 0 auto;"
        >
          <p
            style="box-sizing: border-box; font-family: Helvetica, Arial, sans-serif; letter-spacing: 0.5px; line-height: 1.4; margin: 0; "
          ><strong>Transportation Type:</strong> {{transportType}} Carrier </p>
        </td>
      </tr>

      <tr>
        <td
          valign="top"
          style="width: 600px;padding-bottom: 15px;margin: 0 auto;"
        >
          <p style="font-family: Helvetica, Arial, sans-serif; letter-spacing: 0.5px; line-height: 1.4; margin: 0 0 12px 0;">Thank you,</p>
          <p style="font-family: Helvetica, Arial, sans-serif; letter-spacing: 0.5px; line-height: 1.4; margin: 0 0 12px 0;">McCollister's Auto Transport</p>
          <img
                    src="https://autovista-assets.s3.us-west-1.amazonaws.com/MCC-Wordmark-RGB-Blue.png"
                    alt="McCollister's Auto Transport"
                    width="220"
                    style="display: block; width: 220px; max-width: 220px; height: auto; border: 0; outline: none; text-decoration: none; -ms-interpolation-mode: bicubic; margin: 0 0 12px 0;"
                />
          <p style="font-family: Helvetica, Arial, sans-serif; letter-spacing: 0.5px; line-height: 1.4; margin: 0;"><a href="tel:8888190594" style="color: #0069ca;">(888) 819-0594</a><br />autotransport@mccollisters.com</p>
        </td>
      </tr>

    </table>
  </body>

</html>